   ],
   "source": [
    "l = [1,2,3,4,5,6,7]\n",
    "print(l[3])\n",
    "print(l[-2])\n",
    "print(l[2:4])\n",
    "print(l[::-1])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "de6a7637-7ca3-4ddc-bfd0-9f97740afbe5",
