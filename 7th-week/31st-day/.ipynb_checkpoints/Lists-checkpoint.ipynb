    "#List methods"
   ]
  },
  {
   "cell_type": "raw",
   "id": "ce4a592b-fe6b-426b-b90a-4f469609d38e",
   "metadata": {},
   "source": [
    "appends(): adds one element to the end of the list\n",
    "extends(): adds multiple elements to the list\n",
    "insert(): adds an element at the specified index\n",
    "remove(): removes the first occurence of a specified value\n",
    "pop(): removes and returns the element if no index is supplied it removes the last element\n",
    "clear(): removes all the elements from the list\n",
    "index(): returns the index of the first occurence of value\n",
    "count(): counts how many times a value appears\n",
    "sort(): sorts the original list in the ascending order\n",
    "reverse(): reverses the order of elements in the original list\n",
    "copy(): creates a shallow copy of the list"
   ]
  },
  {
   "cell_type": "raw",
   "id": "e68ed7cb-2970-4086-9ed7-bfa44b10f97b",
   "metadata": {},
   "source": [
    "BUILT IN FUNCTIONS FOR LIST\n",
    "length():\n",
    "max():\n",
    "min():\n",
    "sum():\n",
    "sorted():"
   ]
  },
